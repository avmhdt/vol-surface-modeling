# ---- Core (required; defaults shown work for the free crypto path) ----
DATA_ROOT=~/data/vol-surface-modeling            # required: data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader)
VSM_DATA_DIR=                                    # optional: root of the data tree (raw/, interim/, processed/, exports/); empty = DATA_ROOT
DERIBIT_BASE_URL=https://www.deribit.com/api/v2  # required: Deribit public REST base; no key needed
VSM_LOG_LEVEL=INFO                               # optional: DEBUG|INFO|WARNING
VSM_LOG_JSON=false                               # optional: true = JSON logs (set true on the recorder host)
VSM_RECORDER_CURRENCIES=BTC,ETH                  # optional: currencies the recorder snapshots

# ---- Tardis.dev (optional) ----
TARDIS_DATASETS_URL=https://datasets.tardis.dev/v1  # optional: CSV dataset base; first-of-month files need no key
TARDIS_API_KEY=                                  # optional secret: only if D-02 approves paid daily history

# ---- SPX path (optional; only if D-03 approves a source) ----
FRED_API_KEY=                                    # optional secret: FRED API key for SOFR / Treasury yields
WRDS_USERNAME=                                   # optional: WRDS login name (password lives in ~/.pgpass, never here)
THETADATA_BASE_URL=                              # optional: local Theta Terminal REST URL (check ThetaData docs for port)

# ---- Performance (optional) ----
NUMBA_CACHE_DIR=.numba_cache                     # optional: on-disk JIT cache (agent adds it to .gitignore, D-09)
NUMBA_NUM_THREADS=                               # optional: cap Numba threads; empty = all cores
