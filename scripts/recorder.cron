# vsm-recorder: hourly Deribit snapshots at hh:15 UTC, run from the deploy clone.
# Installed by scripts/deploy_recorder.sh, which keeps other crontab lines. Cron uses the
# host's time zone, so minute-only schedules are safe; the host must stay on a whole-hour
# offset. flock stops a run overlapping a long ticker sweep.
15 * * * * cd "$HOME/deploy/vol-surface-modeling" && VSM_LOG_JSON=true flock -n "$HOME/deploy/vsm-recorder.lock" .venv/bin/vsm record >> "$HOME/data/vol-surface-modeling/logs/cron.log" 2>&1 # vsm-recorder
